    "executor_wbtest.mbt": [ "native" ],
    "lib_test.mbt": [ "native" ],
    "process_js.mbt": [ "js" ],
    "process_native.mbt": [ "native" ],
    "quickcheck_test.mbt": [ "native" ],
    "runner_context_test.mbt": [ "native" ],
    "runtime_test.mbt": [ "native" ],
