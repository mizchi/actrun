{
  "name": "@mizchi/actrun",
  "version": "0.31.0",
  "description": "A local GitHub Actions runner",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/actrun.d.ts",
      "default": "./lib/actrun.js"
    },
    "./cli": "./dist/actrun.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "actrun": "./dist/actrun.js"
  },
  "files": [
    "dist/actrun.js",
    "lib/actrun.js",
    "lib/actrun.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cli": "moon build --release src/cmd/actrun --target js",
    "build:lib": "moon build --release src --target js",
    "build": "npm run build:cli && npm run build:lib && node scripts/bundle-js.js",
    "prepublishOnly": "npm run build",
    "test:smoke": "node dist/actrun.js --help >/dev/null && node dist/actrun.js viz examples/04-multi-job.yml"
  },
  "keywords": [
    "github-actions",
    "workflow",
    "runner",
    "ci",
    "local"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mizchi/actrun.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "oxc-minify": "^0.120.0"
  }
}
